# Copie para .env e ajuste. NUNCA commite o .env.

# MySQL 8 (docker compose sobe um em localhost:3306)
DATABASE_URL="mysql://arena:arena_dev_pwd@localhost:3306/arena_saquarema"
# true só em dev com MySQL 8 local sem TLS. Em produção use TLS e deixe false.
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Swagger UI em /docs e JSON em /api/docs.json (false em produção se a API não for pública)
SWAGGER_ENABLED=true

# E-mail do código de acesso dos alunos (Resend: https://resend.com). Sem a chave, em dev o código sai no log do servidor;
# em produção o login de aluno novo falha (503). MAIL_FROM precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=
MAIL_FROM="Arena Saquarema <no-reply@seudominio.com.br>"

# Pasta das fotos da galeria enviadas pelo admin. Em produção aponte para um disco persistente (ou volume).
UPLOAD_DIR=uploads

# Site público: URL final (usada em sitemap, robots e links de compartilhamento) e contatos exibidos.
# Tudo opcional: o que ficar vazio simplesmente não aparece no site.
SITE_URL=https://seudominio.com.br
CONTACT_WHATSAPP=
CONTACT_ADDRESS=
CONTACT_MAPS_URL=

# Check-ins da TotalPass (passo a passo em docs/parceiros.md). Tudo opcional: sem isso, lance os check-ins à mão.
TOTALPASS_PARTNER_API_KEY=
TOTALPASS_PLACE_API_KEY=
# Base da confirmação do check-in, sem barra no fim (a TotalPass informa o endereço de produção).
TOTALPASS_VALIDATE_URL=
# Segredo que vai na URL do webhook. Gere com: openssl rand -base64 36 | tr '+/' '-_'
TOTALPASS_WEBHOOK_SECRET=

# Nº de proxies reversos na frente do app (0 = acesso direto). Define o IP usado no rate limit do login.
TRUST_PROXY=0

# Usuário admin criado pelo seed (senha mínima 10 caracteres)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@arenasaquarema.com.br
SEED_ADMIN_PASSWORD=
