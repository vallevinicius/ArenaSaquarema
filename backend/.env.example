# Copie para .env e ajuste. NUNCA commite o .env.
NODE_ENV=development
PORT=3333

# MySQL 8 (docker-compose sobe um em localhost:3306)
DATABASE_URL="mysql://arena:arena_dev_pwd@localhost:3306/arena_saquarema"
# true só em dev com MySQL 8 local sem TLS. Em produção use TLS e deixe false.
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origens permitidas (separadas por vírgula). Em produção o front é servido pelo próprio backend.
CORS_ORIGINS=http://localhost:5173

# Serve o build do React (../frontend/dist) na mesma porta da API
SERVE_FRONTEND=false

# Swagger UI em /api/docs (desligue em produção se a API não for pública)
SWAGGER_ENABLED=true

# Usuário admin criado pelo seed (senha mínima 10 caracteres)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@arenasaquarema.com.br
SEED_ADMIN_PASSWORD=

# Nº de proxies reversos na frente da API (0 = acesso direto). Afeta IP usado no rate limit.
TRUST_PROXY=0
